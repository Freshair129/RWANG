{
  "name": "@rwang/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "description": "RWANG — governed autonomous multi-agent orchestrator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Freshair129/RWANG.git"
  },
  "homepage": "https://github.com/Freshair129/RWANG",
  "keywords": [
    "multi-agent",
    "orchestrator",
    "ai-agents",
    "task-dag",
    "claude",
    "ollama",
    "daci-governance"
  ],
  "scripts": {
    "build": "pnpm exec turbo run build",
    "test": "node --test",
    "test:packages": "pnpm exec turbo run test",
    "runtime:smoke": "node --test tests/runtime-import.test.mjs tests/gesture-command-intent.test.mjs tests/host-skill-registry.test.mjs tests/workspace-contracts.test.mjs",
    "verify": "pnpm test && pnpm run runtime:smoke && pnpm run test:packages && py -3 orchestrator/governance/contract_selftest.py && py -3 orchestrator/governance/chain_selftest.py && py -3 orchestrator/governance/w3_review_check.py && py -3 orchestrator/governance/w4_gate_check.py",
    "workspace:graph": "pnpm exec turbo run build --dry=json",
    "ui": "node server.mjs",
    "status": "node orchestrator.mjs status",
    "next": "node orchestrator.mjs next",
    "graph": "node orchestrator.mjs graph",
    "run": "node orchestrator.mjs run",
    "reset": "node orchestrator.mjs reset",
    "prewarm": "node prewarm.mjs",
    "vram": "node vram-mode.mjs",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build"
  },
  "devDependencies": {
    "@rwang/contracts": "workspace:*",
    "@rwang/core": "workspace:*",
    "@tauri-apps/cli": "^2.1.0",
    "turbo": "^2.0.0"
  }
}
